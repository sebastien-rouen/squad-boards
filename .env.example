# Port d'écoute du serveur FastAPI (instance « drafts » : 3010, cf. ecosystem.config.cjs)
PORT=3010

# Base SQLite et pièces jointes de CETTE instance — un projet = une base (docs/multi-instance.md)
# SB_DB_PATH=data/board.db
# SB_UPLOADS_DIR=data/uploads

# JIRA (optionnel) — repli si aucune connexion n'est enregistrée dans Paramètres → JIRA (en base, par instance)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER=your.email@company.com
JIRA_TOKEN=your-api-token
JIRA_PROJECT=PROJ
# Hôtes JIRA auto-hébergés acceptés en plus de *.atlassian.net
# JIRA_ALLOWED_HOSTS=jira.mon-domaine.fr

# Écoute : 127.0.0.1 par défaut (Nginx en local) ; SB_HOST=0.0.0.0 pour exposer sur le réseau.
# SB_RELOAD=false en exploitation (un seul processus, pas de surveillance du code).
# SB_HOST=127.0.0.1
# SB_RELOAD=true

# Authentification SSO BastaVerse (docs/authentification.md) — false = porte ouverte.
AUTH_REQUIRED=false
AUTH_POCKETBASE_URL=http://127.0.0.1:8146
AUTH_PUBLIC_URL=https://auth-drafts.bastou.dev/pb
# Vide = tout compte du hub ; sinon e-mails séparés par des virgules
AUTH_ALLOWED_EMAILS=
