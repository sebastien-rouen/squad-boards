            "Migrer l'API paiement vers la v2"
        ],
        ".mdl-crumb-title": [
            "Refonte du parcours de paiement"
        ],
        ".ticket-assignee": [
            "Alex",
            "Camille",
            "Dominique",
            "Sacha"
        ],
        ".person-picker-name": [
            "Alex Martin",
            "Camille Durand",
            "Dominique Petit",
            "Sacha Bernard"
