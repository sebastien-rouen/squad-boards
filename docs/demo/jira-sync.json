{
    "name": "jira-sync",
    "title": "Synchroniser un ticket avec JIRA depuis sa fiche",
    "description": "Le bouton ↻ compare le ticket local avec JIRA, champ par champ, puis on pousse nos modifications ou on prend la version JIRA, sans quitter la fiche. Instance de démo, réponses JIRA simulées (fixtures/).",
    "audience": "public",
    "brand": "Squad Board",
    "subtitle": "Comparer, puis pousser ou prendre : sans quitter la fiche",
    "url": "http://127.0.0.1:3011/",
    "publicUrl": "https://squad-boards.bastou.dev",
    "server": {
        "cwd": "squad-boards",
        "cmd": [
            "python3",
            "main.py"
        ],
        "env": {
            "PORT": "3011",
            "SB_DB_PATH": "data/demo.db"
        },
        "readyUrl": "http://127.0.0.1:3011/",
        "dbFile": "data/demo.db"
    },
    "colorScheme": "light",
    "localStorage": {
        "sb-theme": "light",
        "sb-jira-url": "https://demo.atlassian.net",
        "sb-jira-user": "demo@example.com",
        "sb-jira-token": "demo-token-fictif"
    },
    "mocks": [
        {
            "url": "**/jira/**",
            "status": 404,
            "body": {
                "errorMessages": [
                    "Simulation : ressource non prévue"
                ]
            }
        },
        {
            "url": "**/jira/rest/api/3/field",
            "file": "fixtures/jira-field.json"
        },
        {
            "url": "**/jira/rest/api/3/priority",
            "file": "fixtures/jira-priority.json"
        },
        {
            "url": "**/jira/rest/api/3/user/assignable/search*",
            "body": [
                {
                    "accountId": "5f1a-demo-camille",
                    "displayName": "Camille Simon"
                }
            ]
        },
        {
            "url": "**/jira/rest/api/3/issue/*",
            "method": "GET",
            "file": "fixtures/jira-issue.json",
            "delayMs": 700
        },
        {
            "url": "**/jira/rest/api/3/issue/*",
            "method": "PUT",
            "file": "fixtures/jira-ok.json",
            "status": 204,
            "delayMs": 500
        },
        {
            "url": "**/jira/rest/api/3/issue/*/transitions",
            "method": "GET",
            "file": "fixtures/jira-transitions.json"
        },
        {
            "url": "**/jira/rest/api/3/issue/*/transitions",
            "method": "POST",
            "file": "fixtures/jira-ok.json",
            "status": 204
        }
    ],
    "ready": ".ticket-card",
    "transition": "zoom",
    "voice": {
        "rate": 1.05
    },
    "prepare": [
        {
            "goto": "#kanban",
            "ready": ".ticket-card",
            "wait": 300
        },
        {
            "eval": "await fetch('/api/tickets/LYR-103', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: \"Proxy inverse pour les services d'authentification\", leader: 'Baptiste Ferry', labels: [], description: '', points: 5, priority: 'high', sprintName: 'Lyra - Ite 5.3' }) });"
        },
        {
            "reload": true,
            "ready": ".ticket-card",
            "wait": 500
        }
    ],
    "steps": [
        {
            "goto": "#kanban",
            "wait": 300
        },
        {
            "caption": "Un ticket local et son jumeau JIRA ont divergé",
            "style": "kinetic"
        },
        {
            "caption": "Ouvrir la fiche",
            "wait": 300
        },
        {
            "click": ".ticket-card[data-ticket-id=\"LYR-103\"]",
            "wait": 1300
        },
        {
            "caption": "Le bouton ↻ compare la fiche avec JIRA",
            "say": "Le bouton de synchronisation compare la fiche avec Jira.",
            "wait": 300
        },
        {
            "zoom": "#mdl-jira-sync",
            "scale": 1.6,
            "wait": 800
        },
        {
            "highlight": "#mdl-jira-sync",
            "tip": "Comparer avec JIRA",
            "wait": 2200
        },
        {
            "highlight": ""
        },
        {
            "zoom": "",
            "wait": 700
        },
        {
            "click": "#mdl-jira-sync",
            "wait": 1800
        },
        {
            "spotlight": "#mjs-panel",
            "label": "ici · dans JIRA : les écarts, champ par champ",
            "wait": 6000
        },
        {
            "spotlight": ""
        },
        {
            "caption": "Prendre JIRA, ou pousser nos modifications : au choix",
            "wait": 300
        },
        {
            "highlight": "#mjs-push",
            "tip": "Pousser vers JIRA les champs cochés",
            "wait": 2200
        },
        {
            "highlight": ""
        },
        {
            "click": "#mjs-push",
            "wait": 1800
        },
        {
            "stamp": "✓ Poussé vers JIRA",
            "tone": "success",
            "pos": "top-right",
            "wait": 1200
        },
        {
            "caption": "Le ticket est aligné, sans quitter la fiche",
            "style": "kinetic",
            "wait": 4200
        },
        {
            "press": "Escape",
            "wait": 700
        },
        {
            "caption": ""
        }
    ],
    "maxSeconds": 120
}
